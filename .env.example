# Postgres on an HDS-certified host in production (Scaleway, OVHcloud...).
# Two roles (docs/COMPLIANCE.md), never a superuser:
#   DATABASE_URL        eclaira_app, used by the running app (append-only on evidence)
#   DATABASE_OWNER_URL  eclaira_owner, used by npm run db:migrate and db:seed only;
#                       if empty, they fall back to DATABASE_URL (local dev)
# Local values below match docker-compose.yml. The database keeps its original name.
DATABASE_URL=postgres://eclaira_app:eclaira_app_dev@localhost:5432/consentza
DATABASE_OWNER_URL=postgres://eclaira_owner:eclaira_owner_dev@localhost:5432/consentza

# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Public URL used in patient links (https in production).
APP_URL=http://localhost:3000

# mock | yousign
SIGNATURE_PROVIDER=mock
YOUSIGN_API_KEY=
YOUSIGN_BASE_URL=https://api-sandbox.yousign.app/v3
YOUSIGN_WEBHOOK_SECRET=

# console | twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# console | smtp (e.g. smtps://user:pass@smtp.example.fr:465)
EMAIL_PROVIDER=console
SMTP_URL=
EMAIL_FROM=Éclaira <no-reply@eclaira.health>

# Secret for the scheduled sender: POST /api/cron/send-due with "Authorization: Bearer <secret>"
CRON_SECRET=change-me

# Yousign requires an e-mail per signer; for SMS-only patients an alias on this domain is used
YOUSIGN_FALLBACK_EMAIL_DOMAIN=

# Shows the mock SMS code on screen. Demo only, never with real patients.
DEMO_MODE=true

# Days a patient link stays valid.
LINK_TTL_DAYS=10

# Password for the seeded demo accounts.
SEED_PASSWORD=eclaira-demo
